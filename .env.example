# Copy to .env and change the secrets:   cp .env.example .env
# .env is git-ignored. NEVER commit real secrets.

APP_ENV=development
API_PORT=8080
DB_HOST_PORT=5433
SWAGGER_PORT=8090

POSTGRES_USER=brightloop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brightloop
# Host "db" is the docker-compose service name. If you run the Go API outside
# Docker, use localhost:5433 instead.
DATABASE_URL=postgres://brightloop:change-me@db:5432/brightloop?sslmode=disable

# At least 32 random characters. Generate one with:  openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-32-output-000000
JWT_TTL_HOURS=8
BCRYPT_COST=12
RESET_TOKEN_TTL_MINUTES=30
INVITE_TOKEN_TTL_HOURS=48

BUSINESS_TIMEZONE=Asia/Kolkata
BILLING_CRON=@every 1h
INVOICE_AUTO_CONFIRM=true

SMTP_HOST=mailpit
SMTP_PORT=1025
# Leave empty for Mailpit; set for a real provider
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=billing@brightloop.local
MAIL_FROM_NAME=Subly
# Put the raw reset/invite code in emails (for Postman). Defaults to true when
# APP_ENV=development. Set false for the demo so emails only show the link.
EMAIL_SHOW_CODES=true

# --- Real email through Gmail (demo machine only) ---------------------------
# 1. Turn on 2-Step Verification for the Gmail account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Replace the five Mailpit lines above with these (app password without spaces), then:
#      docker compose up -d --force-recreate api && make test-email TO=you@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=subly.demo@gmail.com
# SMTP_PASSWORD=your16charapppassword
# MAIL_FROM=subly.demo@gmail.com

FRONTEND_URL=http://localhost:5000
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# First admin account, created by the API on startup if no admin exists.
# Password must meet the policy: 9+ chars, upper, lower, special character.
SEED_ADMIN_EMAIL=admin@brightloop.local
SEED_ADMIN_PASSWORD=Admin#Brightloop1
